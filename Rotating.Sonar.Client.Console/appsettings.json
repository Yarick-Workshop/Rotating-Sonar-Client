{
  "Serial": {
    "DefaultBaudRate": 9600,
    "ReadTimeoutMilliseconds": 250,
    "LinePatternMatchTimeoutMilliseconds": 100,
    "LinePattern": "(?<angle>[+-]?\\d+):\\s*(?<distance>\\d+)cm",
    "FakeData": {
      "FakeSerialLineFormat": "{angle}: {distance}cm",
      "MinAngleDeg": -90,
      "MaxAngleDeg": 90,
      "AngleStepDeg": 15,
      "BaseDistanceCm": 120,
      "DistanceJitterCm": 10,
      "IntervalMilliseconds": 100
    }
  },
  "Visualizer": {
    "BackgroundColor": "#000000",
    "OverlayTextColor": "#FFFFFF",
    "Window": {
      "WidthPx": 1920,
      "HeightPx": 1080,
      "Title": "OpenGL Scan Display"
    },
    "ScanArea": {
      "MaxDistanceCm": 200.0,
      "OuterMarginPx": 40.0,
      "OverlayMarginPx": 10.0
    },
    "Fps": {
      "ShowByDefault": true,
      "HistorySize": 60,
      "OffsetXPx": 10.0,
      "OffsetFromTopPx": 40.0
    },
    "Zoom": {
      "ShowByDefault": true,
      "MinScale": 0.25,
      "MaxScale": 4.0,
      "DefaultScale": 1.0,
      "FactorPerStep": 1.12,
      "MaxWheelExponent": 5.0
    },
    "TextRender": {
      "GlyphTileSizePx": 32,
      "AtlasColumns": 16,
      "TextSizePercentOfTile": 75.0,
      "ExtraGlyphs": "°"
    },
    "ScanPoints": {
      "PointSizePx": 12.0,
      "LineWidthPx": 2.0,
      "CircleSegments": 16,
      "ScanPointColor": "#FF3333",
      "OriginMarkerColor": "#FFFFFF",
      "OffScaleIndicatorColor": "#F2261F",
      "OffScaleIndicator": {
        "ArrowHeadLengthPx": 8.0,
        "ArrowHalfWidthPx": 5.0,
        "RimInsetPx": 8.0,
        "MinTailRadiusPx": 26.0,
        "MinArrowHeadBackPx": 2.5
      }
    },
    "Sweep": {
      "SweepColor": "#141414",
      "LengthPercentOfRadius": 100.0,
      "SweepAngleDeg": 15.0,
      "SweepSegmentCount": 24,
      "ConeCenterAlpha": 0.75,
      "ConeEdgeAlpha": 0.05,
      "LineAlpha": 0.65,
      "LineWidthPx": 1.5
    },
    "RangeGrid": {
      "LineColor": "#4D4D4D80",
      "RangeLabelColor": "#99999980",
      "BearingLabelColor": "#C7C7C780",
      "RangeRingStepCm": 100.0,
      "OuterRingLineWidthPx": 2.0,
      "RadialLineStepDeg": 30,
      "TickStepDeg": 5,
      "MajorTickPerSteps": 2,
      "MajorTickLengthPx": 12.0,
      "MinorTickLengthPx": 7.0,
      "BearingLabelStepDeg": 30,
      "GridCircleSegments": 64
    }
  }
}
